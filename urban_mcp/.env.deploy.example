# Copy to ${ENV_PATH}/.env.mcp.47 and .env.mcp.65 on the respective runner hosts.
# IMAGE_NAME is supplied by the workflow; do not set it in the host env file.
APP_PORT_MAPPING=5301:8001
PROMETHEUS_PORT_MAPPING=9001:9090
LOG_VOLUME=/var/log/urban_mcp
MEM_LIMIT=8G
MEMSWAP_LIMIT=8G
CUSTOM_NETWORK=default
REAL_MCP_CONFIG_PATH=/home/user/idu_api/urban_mcp/config.yaml
